/**
 * @module js.modules.starter
 * @description A boilerplate module inheriting from the base Component.
 */

import Component from '../components/component.js';

/**
 * @class Starter
 * @extends Component
 */
class Starter extends Component {
    /**
     * @param {HTMLElement} element - The DOM element.
     * @param {Object} [options={}] - Configuration options.
     * @param {Deck} [deck=null]    - Deck instance.
     */
    constructor(element, options = {}, deck = null) {
        
        // Define defaults specific to this module
        const defaultOptions = {
            message: 'Hello World',
            alertOnClick: false
        };

        const mergedOptions = { ...defaultOptions, ...options };

        // Setup context for the parent Component class
        const context = {
            name: 'starter',
            element,
            deck,
            ...mergedOptions,
        };

        // Inherit base functionality (State, Config Parsing, etc.)
        super(context);

        // Initialize module-specific logic
        this.init();
    }

    /**
     * Initialization logic
     */
    init() {
        // 'this.message' is automatically available because 
        // Component.#getConfigAttribute() parses data-starter="message:..."
        console.log(`Starter [${this.dci}] initialized with message: ${this.message}`);

        this.element.addEventListener('click', this.onClick);
    }

    /**
     * Example Event Handler
     */
    onClick = (event) => {
        if (this.alertOnClick) {
            alert(this.message);
        }
        
        // Using the base Component's dispatchEvent helper
        this.dispatchEvent('starter:click', { originalEvent: event }, true);
    }

    /**
     * Optional: Handle state changes if this.initState() is called
     */
    onStateChange(state) {
        console.log("Starter module state changed:", state);
    }
}

export default Starter;