{
	"name": "deck",
	"version": "0.9.8",
	"description": "Cyberdeck: Modern-Only Lean Web Framework",
	"author": "Alek Niko",
	"type": "module",
	"private": true,
	"keywords": [
		"vanilla js",
		"lean web",
		"sass",
		"esbuild"
	],
	"dependencies": {
		"@material-symbols/svg-300": "latest",
		"esbuild": "latest",
		"esbuild-sass-plugin": "latest",
		"glob": "latest"
	},
	"scripts": {

		"build": "node src/build/engine.mjs",
		"build:split": "node src/build/engine.mjs --split",
		"build:core": "node src/build/engine.mjs --core",

		"build:pages": "node src/build/engine.mjs --pages",
		"build:prod": "node src/build/engine.mjs --pages --split",

		"dev": "node ssrc/build/engine.mjs --watch --split"
	}
}